   "id": "704cd5b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "ans = []\n",
    "sum = 0\n",
    "for i in arr:\n",
    "    sum = sum+i\n",
    "    ans.append(sum)\n"
   ]
